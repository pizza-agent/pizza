{
  "name": "@pizza/website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4175",
    "build": "node scripts/prepare-assets.mjs && vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4175",
    "deploy": "npm --prefix ../mcp-oauth run deploy",
    "refresh:release": "node scripts/refresh-release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "simple-icons": "^15.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.2",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
