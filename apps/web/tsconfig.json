{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"paths": {
			"@/*": ["./src/*"],
			"@tomsun28/pizza-protocol": ["../../packages/protocol/index.ts"],
			"@pizza/mcp-connector-catalog": ["../../src/builtin-extensions/connectors/catalog.ts"]
		}
	},
	"include": ["src"]
}
